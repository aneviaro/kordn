{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kordn.dev/schema/config/v1alpha1",
  "title": "Kordn LocalRunPolicy",
  "$comment": "JSON Schema validates structural constraints. The pinned schema-check gate also runs Config.Load as the semantic phase for cross-item uniqueness, effective defaults, filesystem safety, and the maxSpoolBodyBytes >= maxInMemoryBodyBytes relation, which JSON Schema cannot express soundly.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "upstream"],
  "properties": {
    "apiVersion": { "const": "kordn.dev/v1alpha1" },
    "kind": { "const": "LocalRunPolicy" },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "region"],
      "properties": {
        "profile": {
          "type": "string", "minLength": 1, "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "not": { "pattern": "^[dD][eE][fF][aA][uU][lL][tT]$" }
        },
        "assumeRoleArn": {
          "type": "string", "maxLength": 2048,
          "pattern": "^$|^arn:(aws|aws-us-gov|aws-cn|aws-iso|aws-iso-b|aws-iso-f):iam::[0-9]{12}:role/[^\\x00\\r\\n]+$"
        },
        "externalId": {
          "anyOf": [
            { "const": "" },
            { "type": "string", "minLength": 2, "maxLength": 1224, "pattern": "^[A-Za-z0-9_+=,.@:/-]+$" }
          ]
        },
        "sourceIdentity": {
          "anyOf": [
            { "const": "" },
            { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[A-Za-z0-9_+=,.@-]+$" }
          ]
        },
        "roleSessionName": {
          "type": "string", "minLength": 2, "maxLength": 64,
          "pattern": "^[A-Za-z0-9_+=,.@-]+$", "default": "kordn-local"
        },
        "durationSeconds": {
          "type": "integer", "minimum": 900, "maximum": 43200, "default": 3600
        },
        "region": {
          "type": "string", "minLength": 3, "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+-[0-9]+$"
        }
      },
      "allOf": [
        {
          "if": { "required": ["externalId"], "properties": { "externalId": { "minLength": 1 } } },
          "then": { "required": ["assumeRoleArn"], "properties": { "assumeRoleArn": { "minLength": 1 } } }
        },
        {
          "if": { "required": ["sourceIdentity"], "properties": { "sourceIdentity": { "minLength": 1 } } },
          "then": { "required": ["assumeRoleArn"], "properties": { "assumeRoleArn": { "minLength": 1 } } }
        }
      ]
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listen": {
          "type": "string",
          "pattern": "^(127\\.0\\.0\\.1|\\[::1\\]):(?:0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
          "default": "127.0.0.1:0"
        },
        "nonAwsTraffic": { "const": "tunnel", "default": "tunnel" },
        "upstreamProxy": { "enum": ["inherit", "none"], "default": "inherit" },
        "maxInMemoryBodyBytes": {
          "type": "integer", "minimum": 1, "maximum": 67108864, "default": 8388608
        },
        "maxSpoolBodyBytes": {
          "type": "integer", "minimum": 1, "maximum": 536870912, "default": 67108864
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "const": "deny", "default": "deny" },
        "rules": {
          "type": "array", "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "effect", "actions", "resources"],
            "properties": {
              "id": {
                "type": "string", "minLength": 1, "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "effect": { "enum": ["allow", "deny"] },
              "actions": {
                "type": "array", "minItems": 1, "maxItems": 1000,
                "items": {
                  "type": "string", "minLength": 1, "maxLength": 512,
                  "pattern": "^\\*$|^[A-Za-z0-9?*-]+:[A-Za-z0-9?*-]+$"
                }
              },
              "resources": {
                "type": "array", "minItems": 1, "maxItems": 1000,
                "items": {
                  "type": "string", "minLength": 1, "maxLength": 512,
                  "pattern": "^[^\\s\\x00-\\x1f\\x7f\\[\\]\\(\\)\\{\\}\\|\\+\\^\\$\\\\]+$"
                }
              },
              "regions": {
                "type": "array", "maxItems": 1000, "uniqueItems": true,
                "items": { "type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+-[0-9]+$" }
              },
              "accounts": {
                "type": "array", "maxItems": 1000, "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[0-9]{12}$" }
              },
              "partitions": {
                "type": "array", "maxItems": 1000, "uniqueItems": true,
                "items": { "enum": ["aws", "aws-us-gov", "aws-cn", "aws-iso", "aws-iso-b", "aws-iso-f"] }
              },
              "allowAwsRequiredWildcard": { "type": "boolean", "default": false }
            },
            "allOf": [
              {
                "if": { "required": ["effect", "allowAwsRequiredWildcard"], "properties": { "effect": { "const": "deny" }, "allowAwsRequiredWildcard": { "const": true } } },
                "then": false
              }
            ]
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string", "minLength": 1, "maxLength": 4096,
          "pattern": ".*[^\\s].*",
          "default": "~/.kordn/audit/events.jsonl"
        },
        "fsync": { "enum": ["batch", "decision"], "default": "batch" },
        "failureMode": { "const": "deny", "default": "deny" },
        "logResourceArns": { "type": "boolean", "default": true },
        "hashResourceNames": { "type": "boolean", "default": false }
      },
      "allOf": [
        {
          "$comment": "logResourceArns defaults to true in Config.Load. Hashing therefore requires an explicit false value rather than permitting omission to select the conflicting default.",
          "if": {
            "required": ["hashResourceNames"],
            "properties": { "hashResourceNames": { "const": true } }
          },
          "then": {
            "required": ["logResourceArns"],
            "properties": { "logResourceArns": { "const": false } }
          }
        }
      ]
    }
  }
}
